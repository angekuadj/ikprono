rules_version = '2';

// Règles Firestore : chaque utilisateur ne peut lire/écrire que ses propres données.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Données applicatives de l'utilisateur (application mobile) :
      // users/{uid}/data/{clé} — favoris, panier, sélections, combinaisons, préférences.
      match /data/{key} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Tout le reste est refusé par défaut.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
