# PostgreSQL sert de cache de secours aux données FotMob.
# À définir si PostgreSQL n'est pas accessible via le socket local par défaut.
# DATABASE_URL=postgresql://user:password@localhost:5432/fotmob
# Ou configurer les variables séparément :
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=fotmob
# PGUSER=angek
# PGPASSWORD=
# PGPOOL_MAX=10

# Authentification OAuth Google et Apple (NextAuth)
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=generer-une-cle-aleatoire-longue
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# URI de redirection Google autorisée : ${NEXTAUTH_URL}/api/auth/callback/google
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=JWT-client-secret-genere-dans-Apple-Developer
# URL de retour Apple : ${NEXTAUTH_URL}/api/auth/callback/apple

# Emplacement du stockage local des coupons générés (facultatif)
# IKPRONO_COUPON_STORE_DB=.coupon-data/generations.sqlite

# Firebase (Auth + Firestore)
# Renseigner avec les valeurs de la console Firebase :
# Console Firebase > Paramètres du projet > Vos applications > Config SDK
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
