# URL publique du site, utilisée pour les métadonnées SEO.
NEXT_PUBLIC_SITE_URL=https://ikprono.onrender.com

# PostgreSQL sert de cache de secours pour les données.
# En production, définir DATABASE_URL avec l'URL interne de la base PostgreSQL Render.
DATABASE_URL=

# Firebase Authentication et Firestore.
# Définir ces valeurs dans l'environnement Render avant le build.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Emplacement du stockage local des coupons générés (facultatif).
# IKPRONO_COUPON_STORE_DB=.coupon-data/generations.sqlite
# PYTHON_EXECUTABLE=python3

# Quotas de combinaisons : valeurs par défaut utilisées si aucun réglage n'a été
# enregistré depuis /admin/offers. Modifiables sans redéploiement.
# QUOTA_GUEST_LIMIT=2
# QUOTA_TRIAL_DAILY_LIMIT=4
# QUOTA_PREMIUM_DAILY_LIMIT=5

# Compte de service Firebase Admin (permet la gestion des offres et des quotas
# depuis l'administration, et l'application des quotas côté serveur).
# Option 1 (développement local) : chemin vers le fichier JSON
# GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/service-account.json
# Option 2 (production sur Render) : variables d'environnement individuelles
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Flutterwave — paiement des offres (voir developer.flutterwave.com).
# Supporte : MTN Mobile Money, Orange Money, WAVE (Sénégal), Moov, Carte bancaire
# La clé PUBLIQUE est visible par le navigateur : c'est normal, elle sert à ouvrir
# la modale de paiement Inline.
NEXT_PUBLIC_FLW_PUBLIC_KEY=
# La clé SECRÈTE ne doit JAMAIS être exposée ni commitée : elle reste côté serveur
# et sert uniquement à vérifier les paiements avant d'activer une offre.
FLW_SECRET_KEY=
# Clé de chiffrement (appels directs par carte uniquement).
FLW_ENCRYPTION_KEY=
# `verif-hash` défini dans le tableau de bord (Settings → Webhooks). Obligatoire
# pour que /api/webhooks/flutterwave accepte un événement : sans lui, tout webhook
# est rejeté.
FLW_WEBHOOK_HASH=
